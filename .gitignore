# Terraform
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfplan
terraform/*.tfvars
terraform/crash.log

K8s/terraform/.terraform/
K8s/terraform/terraform.tfstate
K8s/terraform/terraform.tfstate.backup
K8s/terraform/*.tfplan
K8s/terraform/*.tfvars
K8s/terraform/crash.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Ansible: generated by Terraform (real IPs + secrets) - never committed
Ansible/inventory.ini
Ansible/group_vars/all/vars.yml
Ansible/group_vars/all/secrets.yml
Ansible/*.retry
Ansible/.build/
*.pem

# Local tooling/session state - not part of the project deliverable
.claude/
.mcp.json
